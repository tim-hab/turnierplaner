{
  "name": "turnierplaner",
  "version": "1.0.0-1",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "electron:compile": "tsc -p tsconfig.electron.json",
    "electron:dev": "concurrently -k \"ng serve --configuration development\" \"wait-on http://localhost:4200 && npm run electron:compile && cross-env ELECTRON_DEV_SERVER_URL=http://localhost:4200 electron .\"",
    "electron:build": "npm run build && npm run electron:compile",
    "electron:dist": "npm run electron:build && electron-builder --win --publish never",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:electron": "vitest run electron/*.spec.ts",
    "lint": "ng lint"
  },
  "private": true,
  "packageManager": "npm@12.2.1",
  "dependencies": {
    "@angular/cdk": "22.2.4",
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/material": "22.2.4",
    "@angular/platform-browser": "22.2.3",
    "@angular/router": "22.2.3",
    "@material-design-icons/font": "0.14.15",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.3",
    "@angular/cli": "22.2.5",
    "@angular/compiler-cli": "22.2.3",
    "@eslint/js": "10.0.1",
    "@types/node": "^26.6.5",
    "angular-eslint": "22.6.0",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "eslint": "10.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5",
    "wait-on": "^9.5.1"
  },
  "main": "electron-dist/main.js",
  "allowScripts": {
    "esbuild": false
  }
}
